    local commands; commands=()
    _describe -t commands 'rosregview help find commands' commands "$@"
}
(( $+functions[_rosregview__subcmd__help__subcmd__help_commands] )) ||
_rosregview__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'rosregview help help commands' commands "$@"
}
(( $+functions[_rosregview__subcmd__help__subcmd__info_commands] )) ||
_rosregview__subcmd__help__subcmd__info_commands() {
    local commands; commands=()
    _describe -t commands 'rosregview help info commands' commands "$@"
}
(( $+functions[_rosregview__subcmd__help__subcmd__list_commands] )) ||
_rosregview__subcmd__help__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'rosregview help list commands' commands "$@"
}
(( $+functions[_rosregview__subcmd__help__subcmd__show_commands] )) ||
_rosregview__subcmd__help__subcmd__show_commands() {
    local commands; commands=()
    _describe -t commands 'rosregview help show commands' commands "$@"
