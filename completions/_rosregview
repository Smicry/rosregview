(( $+functions[_rosregview__subcmd__help__subcmd__tree_commands] )) ||
_rosregview__subcmd__help__subcmd__tree_commands() {
    local commands; commands=()
    _describe -t commands 'rosregview help tree commands' commands "$@"
}
(( $+functions[_rosregview__subcmd__info_commands] )) ||
_rosregview__subcmd__info_commands() {
    local commands; commands=()
    _describe -t commands 'rosregview info commands' commands "$@"
}
(( $+functions[_rosregview__subcmd__list_commands] )) ||
_rosregview__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'rosregview list commands' commands "$@"
}
(( $+functions[_rosregview__subcmd__show_commands] )) ||
_rosregview__subcmd__show_commands() {
    local commands; commands=()
    _describe -t commands 'rosregview show commands' commands "$@"
}
(( $+functions[_rosregview__subcmd__tree_commands] )) ||
_rosregview__subcmd__tree_commands() {
    local commands; commands=()
